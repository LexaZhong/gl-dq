{# Standalone pipeline-vs-source-of-truth comparison, for pasting into a SQL editor #}
WITH pipeline AS (
{{ pipeline_sql | indent(2, true) }}
), sot AS (
{{ sot_sql | indent(2, true) }}
)
SELECT
  {% for d in dims %}COALESCE(CAST(p.{{ q(d) }} AS STRING), CAST(s.{{ q(d) }} AS STRING)) AS {{ q(d) }}, {% endfor %}
  {% for m in measures %}
  p.{{ q(m) }} AS {{ q(m ~ "_pipeline") }},
  s.{{ q(m) }} AS {{ q(m ~ "_sot") }},
  COALESCE(p.{{ q(m) }}, 0) - COALESCE(s.{{ q(m) }}, 0) AS {{ q(m ~ "_diff") }},
  CASE WHEN COALESCE(s.{{ q(m) }}, 0) = 0 THEN NULL
       ELSE (COALESCE(p.{{ q(m) }}, 0) - s.{{ q(m) }}) / ABS(s.{{ q(m) }}) END AS {{ q(m ~ "_pct_diff") }}{{ "," if not loop.last }}
  {% endfor %}
FROM pipeline p
FULL OUTER JOIN sot s
  ON {% for d in dims %}{{ dialect.null_safe_eq("CAST(p." ~ q(d) ~ " AS STRING)", "CAST(s." ~ q(d) ~ " AS STRING)") }}{{ "\n AND " if not loop.last }}{% endfor %}

ORDER BY ABS(COALESCE({{ q(measures[0] ~ "_diff") }}, 0)) DESC
