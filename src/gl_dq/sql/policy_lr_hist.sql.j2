WITH p AS (
  SELECT
    {% for k in keys %}{{ sel(k) }}, {% endfor %}
    SUM({{ premium }}) AS premium,
    SUM({{ loss }}) AS loss
  FROM {{ table }}
  GROUP BY {% for k in keys %}{{ loop.index }}{{ ", " if not loop.last }}{% endfor %}
)
SELECT
  {% for s in segments %}{{ q(s) }}, {% endfor %}
  CASE
    WHEN premium <= 0 THEN -2
    WHEN COALESCE(loss, 0) = 0 THEN -1
    ELSE LEAST(CAST(FLOOR(LEAST(loss / premium, {{ cap }}) / {{ cap }} * {{ bins }}) AS INT), {{ bins - 1 }})
  END AS bucket,
  COUNT(*) AS n_policies,
  SUM(premium) AS premium,
  SUM(loss) AS loss
FROM p
GROUP BY {% for s in segments %}{{ loop.index }}, {% endfor %}{{ segments | length + 1 }}
